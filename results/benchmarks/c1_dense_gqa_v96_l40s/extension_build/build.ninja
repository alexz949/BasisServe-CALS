ninja_required_version = 1.3
cxx = g++
nvcc = /deac/opt/rocky9-noarch/nvidia/12.4.1/cuda/12.4.1/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=basisserve_compressed_v_decode_cuda_v13_sm89 -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/TH -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/THC -isystem /deac/opt/rocky9-noarch/nvidia/12.4.1/cuda/12.4.1/include -isystem /home/zhangal/.conda/envs/basis/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -std=c++17
post_cflags = 
cuda_cflags = -ccbin gcc -DTORCH_EXTENSION_NAME=basisserve_compressed_v_decode_cuda_v13_sm89 -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/TH -isystem /home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/include/THC -isystem /deac/opt/rocky9-noarch/nvidia/12.4.1/cuda/12.4.1/include -isystem /home/zhangal/.conda/envs/basis/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=sm_80 -gencode=arch=compute_89,code=sm_89 -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 --use_fast_math --threads 4 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/zhangal/.conda/envs/basis/lib/python3.11/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/deac/opt/rocky9-noarch/nvidia/12.4.1/cuda/12.4.1/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build compressed_v_decode_attention.o: compile /deac/csc/yangGrp/zhangal/BasisServe-CALS/basisserve/kernels/csrc/compressed_v_decode_attention.cpp
build compressed_v_decode_attention.cuda.o: cuda_compile /deac/csc/yangGrp/zhangal/BasisServe-CALS/basisserve/kernels/csrc/compressed_v_decode_attention.cu



build basisserve_compressed_v_decode_cuda_v13_sm89.so: link compressed_v_decode_attention.o compressed_v_decode_attention.cuda.o

default basisserve_compressed_v_decode_cuda_v13_sm89.so
