@@ -0,0 +1,63 @@
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from basisserve.core.llama31_8b_tp8_combined import JointALSTP8Attention
+from benchmarks.system.fused_candidates import candidates
+from benchmarks.system.two_stage_router import Metadata
+
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="Requires CUDA")
+
+
+@pytest.mark.parametrize("batch", [1, 2])
+@pytest.mark.parametrize("length", [4096, 16384, 16416])
+def test_candidate_path_preserves_pages_across_boundary(batch, length):
+    torch.manual_seed(7)
+    keys = torch.randn(batch, 1, length, 128, device="cuda", dtype=torch.bfloat16)
+    query = torch.randn(batch, 4, 1, 128, device="cuda", dtype=torch.bfloat16)
+    metadata = Metadata(keys, length + 64)
+    attention = SimpleNamespace(
+        metadata=metadata,
+        breakdown=None,
+        all_candidate_ids=None,
+        candidate_ids=torch.empty(batch, 1, 512, device="cuda", dtype=torch.long),
+    )
+    storage_pointer = metadata.score_storage.data_ptr()
+    for advance in (False, True):
+        if advance:
+            metadata.advance(torch.randn(batch, 1, 1, 128, device="cuda", dtype=keys.dtype))
+        scores = metadata.scores(query)
+        assert scores.is_contiguous() and scores.data_ptr() == storage_pointer
+        expected = candidates(scores, metadata.n).clone()
+        with patch.object(metadata, "scores", wraps=metadata.scores) as score_call:
+            actual = JointALSTP8Attention._candidate_pages(attention, query)
+            assert score_call.call_count == int(scores.shape[-1] > 512)
+        assert actual.is_contiguous()
+        torch.testing.assert_close(actual, expected, atol=0, rtol=0)
+        again = JointALSTP8Attention._candidate_pages(attention, query)
+        assert again.data_ptr() == actual.data_ptr()
+
+
+@pytest.mark.parametrize("batch", [1, 2])
+@pytest.mark.parametrize("kv_heads", [1, 2])
+def test_reused_coarse_scores_match_reference_after_page_growth(batch, kv_heads):
+    torch.manual_seed(11)
+    keys = torch.randn(batch, kv_heads, 4096, 128, device="cuda", dtype=torch.bfloat16)
+    query = torch.randn(batch, kv_heads * 4, 1, 128, device="cuda", dtype=torch.bfloat16)
+    metadata = Metadata(keys, 4160)
+    pointer = metadata.scores(query).data_ptr()
+    metadata.advance(torch.randn(batch, kv_heads, 1, 128, device="cuda", dtype=keys.dtype))
+    actual = metadata.scores(query)
+    pages = actual.shape[-1]
+    lo = metadata.minimum[:, :, :pages].float()
+    hi = metadata.maximum[:, :, :pages].float()
+    q = query.reshape(batch, kv_heads, 4, 1, 128).float()
+    expected = torch.maximum(q * lo[:, :, None], q * hi[:, :, None]).sum(-1) * 128**-0.5
+    counts = (metadata.n - torch.arange(pages, device="cuda") * 32).clamp(1, 32)
+    expected += counts.float().log()
+    expected.masked_fill_(torch.arange(pages, device="cuda") * 32 >= metadata.n, -torch.inf)
+    assert actual.data_ptr() == pointer and actual.is_contiguous()
+    torch.testing.assert_close(actual, expected, atol=2e-5, rtol=2e-6)
