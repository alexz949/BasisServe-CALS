diff --git a/benchmarks/system/bench_tp8_candidate_path.py b/benchmarks/system/bench_tp8_candidate_path.py
new file mode 100644
index 0000000..fe1aa43
--- /dev/null
+++ b/benchmarks/system/bench_tp8_candidate_path.py
@@ -0,0 +1,125 @@
+"""Compare TP8 candidate selection before and after workspace reuse."""
+
+import argparse
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+import statistics
+import sys
+import time
+from types import SimpleNamespace
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+
+from basisserve.core.llama31_8b_tp8_combined import JointALSTP8Attention
+from benchmarks.system.fused_candidates import candidates
+from benchmarks.system.two_stage_router import Metadata, _coarse
+
+
+def measure(call, iterations):
+    begin, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    torch.cuda.synchronize()
+    start = time.perf_counter()
+    begin.record()
+    for _ in range(iterations):
+        call()
+    end.record()
+    end.synchronize()
+    return {
+        "stream_us": begin.elapsed_time(end) * 1000 / iterations,
+        "wall_us": (time.perf_counter() - start) * 1e6 / iterations,
+    }
+
+
+@torch.inference_mode()
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--lengths", nargs="+", type=int, default=[4096, 16384, 65536, 130048])
+    parser.add_argument("--batches", nargs="+", type=int, default=[1, 8])
+    parser.add_argument("--iterations", type=int, default=32)
+    parser.add_argument("--trials", type=int, default=5)
+    parser.add_argument("--decode-offset", type=int, default=17)
+    parser.add_argument("--output", type=Path, default=ROOT / "results/system_benchmarks/tp8_path_opt/candidates.json")
+    args = parser.parse_args()
+    assert args.iterations > 0 and args.trials > 0
+    assert args.decode_offset >= 0
+    assert all(length >= 4096 for length in args.lengths)
+    assert all(batch > 0 for batch in args.batches)
+    torch.set_num_threads(2)
+    torch.manual_seed(42)
+    results = []
+    for length in args.lengths:
+        for batch in args.batches:
+            cache_length = length + args.decode_offset
+            keys = torch.randn(batch, 1, cache_length, 128, device="cuda", dtype=torch.bfloat16)
+            query = torch.randn(batch, 4, 1, 128, device="cuda", dtype=keys.dtype)
+            metadata = Metadata(keys, cache_length + 144)
+            pages = (cache_length + 31) // 32
+            old_ids = torch.empty(batch, 1, 512, device="cuda", dtype=torch.long)
+            attention = SimpleNamespace(
+                metadata=metadata, breakdown=None, all_candidate_ids=None,
+                candidate_ids=torch.empty_like(old_ids),
+            )
+
+            def original_scores():
+                count = (metadata.n + 64 + 31) // 32
+                scores = torch.empty(query.shape[0], metadata.h, 4, count, device=query.device)
+                _coarse[(query.shape[0] * metadata.h * 4, (count + 15) // 16)](
+                    query, metadata.minimum, metadata.maximum, scores,
+                    metadata.h, metadata.cap, count, metadata.n, *query.stride()[:2],
+                )
+                return scores
+
+            def before():
+                # The archived path allocates and scores even when all pages survive.
+                return candidates(original_scores(), metadata.n, output=old_ids)
+
+            def after():
+                return JointALSTP8Attention._candidate_pages(attention, query)
+
+            expected = before().clone()
+            torch.testing.assert_close(after(), expected, atol=0, rtol=0)
+            for _ in range(10):
+                before()
+                after()
+            samples = {"before": [], "after": []}
+            for trial in range(args.trials):
+                order = [("before", before), ("after", after)]
+                if trial % 2:
+                    order.reverse()
+                for name, call in order:
+                    samples[name].append(measure(call, args.iterations))
+            row = {"length": length, "cache_length": cache_length, "batch": batch, "pages": pages, "candidate_ids_equal": True}
+            for name, values in samples.items():
+                row[name] = {
+                    metric: statistics.median(value[metric] for value in values)
+                    for metric in ("stream_us", "wall_us")
+                }
+            row["samples"] = samples
+            results.append(row)
+            print(json.dumps({key: value for key, value in row.items() if key != "samples"}), flush=True)
+            del attention, metadata, keys, query, old_ids, expected
+
+    payload = {
+        "scope": "Single-rank candidate selection only; synthetic BF16 inputs; steady-state fixed length",
+        "timing": "CUDA event intervals include stream idle time between eager launches; wall intervals include synchronization",
+        "limitations": "Excludes page-boundary updates, fine routing, K fetch, attention, decoder, and TP communication",
+        "recorded_at_utc": datetime.now(timezone.utc).isoformat(),
+        "command": sys.argv,
+        "conda_environment": "basis",
+        "gpu": torch.cuda.get_device_name(),
+        "pytorch": torch.__version__,
+        "iterations": args.iterations,
+        "trials": args.trials,
+        "decode_offset": args.decode_offset,
+        "results": results,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(payload, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
